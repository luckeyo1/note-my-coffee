{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".git/**",
      ".github/**",
      ".vscode/**",
      ".idx/**",
      ".claude/**",
      ".firebaserc",
      ".gitignore",
      "**/node_modules/**",
      "firebase-debug.log",

      "**/*.md",
      "*.docx",
      "scripts/**",
      "store/**",
      "package.json",
      "package-lock.json",
      "생성된 이미지*.png",

      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules"
    ]
  },

  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },

  "storage": {
    "rules": "storage.rules"
  },

  "emulators": {
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true },
    "singleProjectMode": true
  }
}
