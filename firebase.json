{
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          { "key": "Content-Type", "value": "application/json" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".git/**",
      ".github/**",
      ".vscode/**",
      ".idx/**",
      ".claude/**",
      ".firebaserc",
      ".gitignore",
      "**/node_modules/**",
      "firebase-debug.log",

      "**/*.md",
      "*.docx",
      "scripts/**",
      "store/**",
      "package.json",
      "package-lock.json",
      "생성된 이미지*.png"
    ]
  }
}
