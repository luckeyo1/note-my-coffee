rules_version = '2';
// Note My Coffee — Firestore 보안 규칙 (레시피 공유 커뮤니티 포함)
//
// ⚠️ 이 파일은 산출물이다. 아직 어디에도 게시되지 않았고, firebase.json에도
//    연결하지 않았다(실수 배포 방지). 게시는 소유자가 의도적으로 해야 한다:
//      firebase deploy --only firestore:rules
//    또는 콘솔 > Firestore > 규칙에 붙여넣기. (docs/recipe-community.md 참고)
//
// 앞부분(recipes·users·stats_*·leads·public_stats)은 현재 콘솔에 게시된 규칙과
// 동일하다 — 기존 기능을 깨지 않기 위해 그대로 유지한다. 뒷부분(posts·reports·
// blocks·profiles)이 이번에 추가되는 공유 기능용이다.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'qorlgh1994@gmail.com'
          && request.auth.token.email_verified == true
          && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // ───────────────────────── 기존 규칙 (변경 없음) ─────────────────────────
    match /recipes/{recipeId} {
      allow read: if isAdmin()
                  || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

    match /public_stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stats_daily/{day} {
      allow read: if isAdmin();
      allow write: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /stats_beans/{beanId} {
      allow read: if isAdmin();
      allow write: if request.auth != null;
    }

    match /stats_visits/{day} {
      allow read: if isAdmin();
      allow write: if true;
    }

    match /leads/{leadId} {
      allow create, update: if request.resource.data.email is string
                            && request.resource.data.email.size() > 3
                            && request.resource.data.email.size() < 200
                            && request.resource.data.source is string;
      allow read, delete: if isAdmin();
    }

    // ───────────────────────── 공유 기능 (신규) ──────────────────────────────

    // 공개 게시물(개인 기록에서 뽑아낸 공개 스냅샷).
    //   visibility: 'private' | 'unlisted' | 'public'
    //   status:     'active' | 'hidden'   (hidden은 작성자 비공개 또는 관리자 숨김)
    //   hiddenByAdmin: bool  (관리자 숨김 표식 — 작성자는 건드릴 수 없다)
    match /posts/{postId} {

      function existing() { return resource.data; }
      function incoming() { return request.resource.data; }
      function isPostOwner() {
        return request.auth != null && existing().ownerId == request.auth.uid;
      }
      // 생성/수정 시 공통 유효성. 공개 텍스트는 길이 제한, 열거형은 화이트리스트.
      function validPost() {
        return incoming().ownerId is string
            && incoming().visibility in ['private', 'unlisted', 'public']
            && incoming().status in ['active', 'hidden']
            && incoming().title is string && incoming().title.size() <= 120
            && (!('description' in incoming()) || incoming().description.size() <= 2000)
            && incoming().method in ['espresso', 'drip'];
      }

      // get(단건): 소유자·관리자, 그리고 활성 상태의 public/unlisted.
      //   unlisted는 '추측하기 어려운 문서 ID'가 곧 링크의 비밀이다.
      //   '공유 해제'(visibility→private)하면 이 규칙이 매 읽기마다 다시 검사되어
      //   비소유자 접근이 즉시 막힌다(§8).
      allow get: if isAdmin()
                 || isPostOwner()
                 || (existing().status == 'active'
                     && existing().visibility in ['public', 'unlisted']);

      // list(쿼리): 피드·프로필은 public+active만 열거할 수 있다. unlisted가 섞인
      //   쿼리는 이 규칙이 그 문서에서 실패하므로 통째로 거부된다 → unlisted 열거 불가.
      //   (내 목록은 ownerId==uid로 필터하면 소유자 분기로 허용된다.)
      allow list: if isAdmin()
                  || (request.auth != null && resource.data.ownerId == request.auth.uid)
                  || (resource.data.status == 'active' && resource.data.visibility == 'public');

      allow create: if isSignedIn()
                    && incoming().ownerId == request.auth.uid
                    && incoming().status == 'active'
                    && incoming().hiddenByAdmin == false
                    && validPost();

      // 작성자 수정: 소유자 유지, 관리자 숨김은 건드릴 수 없다.
      //   - ownerId 변경 금지
      //   - hiddenByAdmin 플래그를 스스로 바꿀 수 없음
      //   - 관리자 숨김 상태(hiddenByAdmin==true)면 status를 active로 되돌릴 수 없음(§9)
      allow update: if isPostOwner()
                    && incoming().ownerId == existing().ownerId
                    && incoming().hiddenByAdmin == existing().hiddenByAdmin
                    && !(existing().hiddenByAdmin == true && incoming().status != 'hidden')
                    && validPost();

      // 관리자 수정: 숨김/해제 및 hiddenByAdmin 표식을 다룰 수 있다.
      allow update: if isAdmin();

      allow delete: if isPostOwner() || isAdmin();
    }

    // 신고. 로그인 사용자가 생성만, 열람·처리는 관리자만(§9).
    match /reports/{reportId} {
      allow create: if isSignedIn()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.targetPostId is string
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if isAdmin();
    }

    // 차단 목록. 각 사용자 본인만 읽고 쓴다. 피드에서 차단 작성자 제외는
    // 클라이언트가 이 목록으로 거른다(규칙은 조인을 못 한다 → 완전한 차단이 아님, §9).
    match /blocks/{ownerUid}/blocked/{blockedUid} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    // 공개 프로필. 공개 필드만 담는 별도 문서라 누구나 읽을 수 있다.
    //   이메일·개인 기록은 여기 두지 않는다(그건 users 컬렉션, 위에서 비공개).
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && (!('displayName' in request.resource.data) || request.resource.data.displayName.size() <= 40)
                   && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 200);
    }
  }
}
